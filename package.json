{
    "name": "shellform",
    "displayName": "Shellform",
    "icon": "images/icon.png",
    "version": "0.2.0",
    "publisher": "crisvsgame",
    "description": "Format shell scripts using shfmt.",
    "categories": [
        "Formatters"
    ],
    "extensionKind": [
        "workspace"
    ],
    "keywords": [
        "shell",
        "bash",
        "sh",
        "formatter",
        "shfmt"
    ],
    "homepage": "https://github.com/CRISvsGAME/shellform#readme",
    "bugs": {
        "url": "https://github.com/CRISvsGAME/shellform/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/CRISvsGAME/shellform.git"
    },
    "license": "SEE LICENSE IN LICENSE",
    "author": "CRISvsGAME <cris@crisvsgame.com>",
    "main": "./out/extension.js",
    "files": [
        "out/extension.js",
        "images/icon.png",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "activationEvents": [
        "onLanguage:shellscript"
    ],
    "engines": {
        "vscode": "^1.101.0"
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "npm run build && vscode-test",
        "test:lifecycle": "npm run build && node --test test/lifecycle.test.cjs"
    },
    "devDependencies": {
        "@types/mocha": "10.0.10",
        "@types/node": "22.15.1",
        "@types/vscode": "1.101.0",
        "@vscode/test-cli": "0.0.15",
        "@vscode/test-electron": "3.1.0",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "diff": "^9.0.0",
        "serialize-javascript": "^7.0.6"
    }
}
